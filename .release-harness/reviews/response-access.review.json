    {
      "id": "F10",
      "claim": "Both exact-source fresh and upgrade profiles passed all 48 selected fixture cases and first-start/restart browser checks, with zero live provider calls. Upgrade archive, rekey, original snapshot and rollback checks passed; the runner cleaned its temporary resources.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Private canonical-image fresh and upgrade installed receipts, including rollback and image-identity assertions" }
