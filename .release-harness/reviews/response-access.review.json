  "facts": [
    {
      "id": "F1",
      "claim": "The reviewed primary source is the clean committed Git tree at 16ddc5b2e5054cc2474ba532325e5c9b5d224c01. Its comparison with the previous reviewed head covers 39 changed product paths, including the released Translate pin, conversion and catalog policy, key-access API and console, provider-probe clock correction, tests and rebuilt console assets.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Release-Harness exact Git source capture and reviewed source diff" }
    },
    {
      "id": "F2",
      "claim": "The committed Go module requires published llm-translate v0.0.7 without a local replacement. That Translate release points to a CI-passing source; Gateway module verification, build, vet, staticcheck and vulnerability scan exited successfully with GOWORK=off.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Go module graph and local build, vet, staticcheck and govulncheck; published Translate release and CI status" }
    },
    {
      "id": "F3",
      "claim": "The full Gateway Go test suite passed against the pinned released module. A frozen-clock regression went red before the provider-probe timestamp correction and passed 100 consecutive executions afterward; the stale-event account guard also passed.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "GOWORK=off go test ./... -count=1 and targeted frozen-clock account-recovery/IAM guard tests" }
    },
    {
      "id": "F4",
      "claim": "The canonical Dockerfile built a disposable image from the committed Gateway Go tree and the pinned public Translate module. Installed CLI version/build identity and CLI health checks passed on first start and restart in both isolated profiles. The local qualification version and commit label are not release build stamps.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Canonical Dockerfile build and installed first-start/restart CLI checks with the private fresh/upgrade receipts" }
    },
    {
      "id": "F5",
      "claim": "The isolated installed Gateway answered the public health check without caller credentials and served a models list to an authorized project key. Scoped catalog and route-member tests checked the changed model listing and authorization boundaries.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Installed first-start/restart health and public-catalog cases; Gateway caller-scope, catalog and key-policy Go tests" }
    },
    {
      "id": "F6",
      "claim": "Installed Chat, Responses and Messages refusal/compatibility cases and the full Go suite passed after changing the conversion and route-save policy. The public API error-envelope assertions remained satisfied under the three respective ingress handlers.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Installed native phase, protocol-boundary, header/body refusal and conversion matrices plus full Go API tests" }
    },
    {
      "id": "F7",
      "claim": "An unauthenticated administrator request remains refused. The new key-access read is scoped to the administrator or owning portal principal, returns no key token, and refuses another portal owner; first-start/restart browser authentication journeys passed.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Gateway key-access HTTP regression and installed browser sign-in, unauthorized API and current-access journeys" }
    },
    {
      "id": "F8",
      "claim": "The embedded console is served by the canonical image. The console passed lint, 283 component tests, a deterministic rebuild with check:dist, and the installed desktop/mobile browser journeys on first start and restart.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "npm lint/test/check:dist and installed first-start/restart browser receipts" }
    },
    {
      "id": "F9",
      "claim": "The gateway metrics endpoint refused callers without its separate token, retained its build-identity metric and reset process counters on restart under the installed fixture suite.",
      "status": "observed",
      "evidence": { "source": "16ddc5b2e5054cc2474ba532325e5c9b5d224c01", "method": "Installed metrics token/build-identity case and process restart recovery" }
