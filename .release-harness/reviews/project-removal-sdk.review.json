      }
    },
    {
      "id": "F3",
      "claim": "With the cross-client fixture explicitly enabled, the actual gateway handler served a scoped snapshot. The Node, Python and Go clients used the cached direct route for JSON and converted streaming responses after the fixture gateway became unavailable.",
      "status": "observed",
      "evidence": {
        "source": "go/internal/api/client_snapshot_test.go, sdk/README.md",
        "method": "LLMGW_SDK_E2E=1 go test ./internal/api -run TestClientSnapshotHTTPProvidesUsableDirectConnection -count=1 from go/."
      }
    },
    {
      "id": "F4",
      "claim": "The standalone SDK suites passed on the reviewed source. The Node and Python suites each passed 12 tests, and the Go SDK package passed.",
      "status": "observed",
      "evidence": {
